{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/migrations",
    "rootDir": "./migrations",
    "module": "CommonJS",
    "target": "ES2020",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["migrations/**/*"],
  "exclude": []
}

